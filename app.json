{
  "expo": {
    "name": "GripState",
    "slug": "gripstate-gym-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#0A3622"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gripstate.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "GripState needs calendar access to schedule workout sessions.",
        "NSFaceIDUsageDescription": "GripState uses Face ID / Touch ID to secure gym client records."
      }
    },
    "android": {
      "package": "com.gripstate.app",
      "backgroundColor": "#0A3622",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-calendar",
      "expo-local-authentication"
    ]
  }
}
